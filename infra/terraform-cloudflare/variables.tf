variable "account_id" {
  description = "Cloudflare account ID dedicated to CodeXPT deployments."
  type        = string

  validation {
    condition     = can(regex("^[0-9a-f]{32}$", var.account_id))
    error_message = "account_id must be a 32-character lowercase Cloudflare account ID."
  }
}

variable "worker_name" {
  description = "Stable production Worker name."
  type        = string
  default     = "codexpt-api"

  validation {
    condition     = can(regex("^[a-z0-9][a-z0-9-]{1,56}[a-z0-9]$", var.worker_name))
    error_message = "worker_name must be a lowercase DNS-safe name from 3 to 58 characters."
  }
}

variable "database_name" {
  description = "Non-destructive D1 database name for the CodeXPT API."
  type        = string
  default     = "codexpt-production"

  validation {
    condition     = can(regex("^[a-z0-9-]{3,64}$", var.database_name))
    error_message = "database_name must use 3–64 lowercase letters, digits, or hyphens."
  }
}

variable "workers_dev_subdomain" {
  description = "Existing Cloudflare workers.dev account subdomain, without the suffix."
  type        = string

  validation {
    condition     = can(regex("^[a-z0-9][a-z0-9-]{0,56}[a-z0-9]$", var.workers_dev_subdomain))
    error_message = "workers_dev_subdomain must be the lowercase account subdomain only."
  }
}

variable "worker_bundle_path" {
  description = "Path to the reviewed, bundled Worker artifact generated by the local build step."
  type        = string
}

variable "production_release_ready" {
  description = "Set true only after the Worker implements and passes all production release gates."
  type        = bool
  default     = false
}

variable "compatibility_date" {
  description = "Cloudflare Workers runtime compatibility date; review before changing."
  type        = string
  default     = "2026-10-11"

  validation {
    condition     = can(regex("^20[0-9]{2}-[0-9]{2}-[0-9]{2}$", var.compatibility_date))
    error_message = "compatibility_date must use YYYY-MM-DD format."
  }
}

variable "web_origin" {
  description = "Canonical Vercel production origin. Keep the callback on this exact origin."
  type        = string
  default     = "https://codexpt.vercel.app"

  validation {
    condition     = can(regex("^https://[a-z0-9.-]+$", var.web_origin))
    error_message = "web_origin must be one HTTPS origin without a path, query, or fragment."
  }
}

variable "oidc_issuer" {
  description = "Dedicated CodeXPT OIDC issuer; do not reuse QAPAQ's application."
  type        = string
  default     = ""
  sensitive   = false
}

variable "oidc_client_id" {
  description = "Client ID registered for CodeXPT's exact OIDC callback."
  type        = string
  default     = ""
  sensitive   = false
}
